amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {

    //["check-conventional-commits"] = Builtins.checkConventionalCommits
    //["check-executables-have-shebangs"] = Builtins.checkExecutablesHaveShebangs

    ["ruff"] = Builtins.ruff
    ["ruff-format"] = Builtins.ruff_format
    ["mypy"] = (Builtins.mypy) {
        glob = "**/*.py"
        exclude = List("**/venv/**", "**/.venv/**", "**/env/**", "**/.env/**")
        dir = "custom_components"
    }

    // `bun lint` replaces Biome as the linter (canary-only until the next
    // stable Bun). It reads frontend/eslint.config.js natively, including the
    // custom srat/registered-test-id rule, so ESLint no longer runs separately.
    ["bun-lint"] {
        glob = "**/*.{js,jsx,ts,tsx}"
        check = "bun lint --no-script"
        fix = "bun lint --no-script --fix"
    }

    ["bun-fmt"] {
        glob = "**/*.{js,jsx,ts,tsx,json,jsonc,yaml,yml,toml,md,mdx,css,scss,html,vue,graphql}"
        check = "bun fmt --check --staged"
        fix = "bun fmt --staged"
    }

    ["go-fmt"] = (Builtins.go_fmt) {
        glob = "**/*.go"
        exclude = "vendor/**/*.go"
        dir = "backend/src"
    }
//    ["go-sec"] = (Builtins.go_sec) {
//        glob = "**/*.go"
//        exclude = "vendor/**/*.go"
//        dir = "backend/src"
//        check = "gosec -exclude-generated -severity high -confidence high ./..."
//    }
    ["go-vet"] = (Builtins.go_vet) {
        glob = "**/*.go"
        exclude = "vendor/**/*.go"
        dir = "backend/src"
        check = "test -f config/metadata_constants.go || mise run //backend:metadata --version dev && go vet ./..."
    }
    ["golangci-lint"] = (Builtins.golangci_lint) {
        glob = "**/*.go"
        exclude = "vendor/**/*.go"
        dir = "backend/src"
        check = "golangci-lint run --fix=false  --fast-only  ./..."
        fix = "golangci-lint run --fix ./..."
    }

    ["gomod-tidy"] = (Builtins.gomod_tidy) {
        glob = "go.mod"
        dir = "backend/src"
    }
//    ["err-check"] = (Builtins.err_check) {
//        glob = "**/*.go"
//    }

    ["markdownlint-cli2"] {
        glob = "**/*.md"
        check = "./scripts/validate-docs.sh --markdownlint-only"
        fix = "./scripts/validate-docs.sh --markdownlint-fix-only"
    }
    ["vale"] = (Builtins.vale) {
        glob = "**/*.md"
        check = "./scripts/validate-docs.sh --vale-only"
    }

    ["mise"] = (Builtins.mise) {
        //glob = "**/*.ts"
    }

    ["shellcheck"] = Builtins.shellcheck
    ["shfmt"] = Builtins.shfmt

    ["taplo"] = Builtins.taplo

    ["yamllint"] {
        glob = "**/*.{yaml,yml}"
        check = "yamllint ."
    }

}

hooks {
    ["pre-commit"] {
        fix = true
        // Do NOT stash unstaged changes: backend vendor patches
        // (backend/patches/, applied via `mise run //backend:patch`) live as
        // uncommitted working-tree modifications by design, and go-vet needs
        // them present to compile (e.g. sgio.CheckAtaDevice). Stashing them
        // makes every commit fail vet on files the commit does not touch.
        stash = "none"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
