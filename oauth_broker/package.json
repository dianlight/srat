{
  "name": "srat-oauth-broker",
  "version": "0.0.0",
  "description": "SRAT hosted OAuth broker — serverless TypeScript (Cloudflare Workers + Render) for shared Dropbox OAuth (issue #1002)",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:worker": "wrangler dev",
    "build": "bun tsc --noEmit",
    "test": "bunx --bun vitest run",
    "test:ci": "bunx vitest run --coverage --reporter=verbose",
    "lint": "bun lint --no-script",
    "format": "bun fmt .",
    "deploy:worker": "wrangler deploy",
    "deploy:render": "bun run build",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.155.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.4"
}
